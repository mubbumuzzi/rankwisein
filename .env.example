# Copy to .env on your VPS and fill in strong secrets (never commit .env)

# ---- SQL Server ----
MSSQL_SA_PASSWORD=ChangeMe_Strong@Pass123
MSSQL_DATABASE=rankwise

# ---- Backend ----
JWT_SECRET=change-me-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=https://rankwise.co.in,https://www.rankwise.co.in

# ---- Seeded admin (change before going live) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@rankwise.local
ADMIN_PASSWORD=change-me-strong-admin-password

# ---- Cursor Cloud Agents (AI Counsellor) ----
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_ENABLED=true
